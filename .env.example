# SpeakHub environment variables.
# Copy to .env.local for local development. Never commit a filled-in copy.
# Production values live in Vercel Project Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project REST URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key. Full database access, bypasses Row Level Security.
# Server-side only. Rotating this key invalidates every deployed function.
SUPABASE_SECRET_KEY=

# Publishable (anon) key. Used by api/sessions.js for the public timetable RPC.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# ---------------------------------------------------------------------------
# Shared password checked by /api/admin?action=login.
SPEAKHUB_ADMIN_PASSWORD=

# HMAC key signing the 8-hour admin bearer token.
SPEAKHUB_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# Teacher app (/teacher)
# ---------------------------------------------------------------------------
# HMAC key signing the 12-hour teacher bearer token.
# MUST be set explicitly: api/teacher.js currently falls back to
# SPEAKHUB_ADMIN_SECRET and then to SUPABASE_SECRET_KEY when this is empty.
SPEAKHUB_TEACHER_SECRET=

# ---------------------------------------------------------------------------
# PayOS payment gateway
# ---------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Base URL used to build PayOS return/cancel URLs. Must match the deployment.
# Defaults to https://speakhub.vn when unset.
PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OpenAI (placement test, progress test, topic vocabulary)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Scoring / vocabulary model. Default when unset: gpt-5-mini
OPENAI_PLACEMENT_MODEL=gpt-5-mini

# Speech-to-text model. Default when unset: gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
